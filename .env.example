# =============================================================================
# Marine Data Layer — local stack configuration (EXAMPLE)
# -----------------------------------------------------------------------------
# Copy to `.env` (`make env` or `cp .env.example .env`) and adjust as needed.
# .env is git-ignored. NEVER commit real credentials.
# All values below are LOCAL-DEV placeholders and are safe defaults only for a
# self-hosted development stack — rotate/replace before any shared deployment.
# =============================================================================

# -----------------------------------------------------------------------------
# Global
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=marine
TZ=UTC
LOG_LEVEL=INFO
ENVIRONMENT=local

# -----------------------------------------------------------------------------
# PostgreSQL + PostGIS + TimescaleDB
# -----------------------------------------------------------------------------
POSTGRES_USER=marine
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=marine
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# SQLAlchemy / psycopg URL consumed by API, workers and Alembic.
# NOTE: uses the psycopg (v3) driver to match pyproject (psycopg[binary]).
DATABASE_URL=postgresql+psycopg://marine:change_me_local_only@postgres:5432/marine

# -----------------------------------------------------------------------------
# Redis (cache + rate-limit + light broker)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# NATS JetStream (event-driven work queues + live alert events)
# -----------------------------------------------------------------------------
NATS_URL=nats://nats:4222
NATS_JETSTREAM_ENABLED=true
# Logical subjects (documented contract; workers subscribe by role)
NATS_SUBJECT_ALERTS=alert.*
NATS_SUBJECT_INGEST=ingest.*
NATS_SUBJECT_PROCESS=process.*
NATS_SUBJECT_EVENTS=events.*

# -----------------------------------------------------------------------------
# MinIO / S3-compatible object storage (immutable raw + processed artifacts)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=marine_minio
MINIO_ROOT_PASSWORD=change_me_local_only
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=marine_minio
S3_SECRET_ACCESS_KEY=change_me_local_only
# Buckets created at bootstrap by the `minio-init` service.
S3_BUCKET_RAW=marine-raw
S3_BUCKET_PROCESSED=marine-processed
S3_BUCKET_ARTIFACTS=marine-artifacts

# -----------------------------------------------------------------------------
# FastAPI application
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
# Import path of the ASGI app. Coordinated with backend package `marine_data_engine`.
# Override if the backend team exposes the app under a different attribute.
API_APP_MODULE=marine_data_engine.api.app:app

# -----------------------------------------------------------------------------
# Workers (separated roles / queues)
#   ingest  -> source fetch -> raw object store
#   process -> decode/normalize/QC/derived products (heavy scientific)
#   alerts  -> priority CAP/hazard events (isolated from batch/backfill)
# -----------------------------------------------------------------------------
WORKER_INGEST_CONCURRENCY=2
WORKER_PROCESS_CONCURRENCY=2
WORKER_ALERTS_CONCURRENCY=1
WORKER_RETRY_MAX=5
WORKER_RETRY_BACKOFF_BASE_SECONDS=2
WORKER_RETRY_BACKOFF_JITTER_SECONDS=1

# -----------------------------------------------------------------------------
# Airflow (lightweight LocalExecutor runtime: init + scheduler + webserver)
# -----------------------------------------------------------------------------
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=false
# Airflow metadata DB (separate logical DB on the same Postgres instance)
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://marine:change_me_local_only@postgres:5432/airflow
# Fernet key for connection/variable encryption. Generate a real one for shared use:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_local_only
AIRFLOW_WEB_PORT=8080

# -----------------------------------------------------------------------------
# Dashboard (React + Vite, served static via nginx in the stack)
# -----------------------------------------------------------------------------
DASHBOARD_PORT=5173
# Base URL the dashboard uses to reach the API (through the host).
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_local_only
# OpenTelemetry (OTLP over gRPC to the collector)
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAMESPACE=marine
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# -----------------------------------------------------------------------------
# Source connector credentials (LEAVE BLANK LOCALLY — verification pending)
# See SOURCE_GAPS.md. Do NOT commit real tokens.
# -----------------------------------------------------------------------------
# MOSDAC authenticated download (AUTH-A) — blank keeps connector disabled.
MOSDAC_USERNAME=
MOSDAC_PASSWORD=
# IMD registered API / DSP (REG-A) — blank keeps connector disabled.
IMD_API_TOKEN=
# INCOIS ERDDAP TLS: connector must bundle the GlobalSign intermediate (V3-TLS).
# Provide a path to the intermediate CA bundle mounted into the containers.
INCOIS_CA_BUNDLE=/etc/ssl/certs/incois-intermediate.crt
