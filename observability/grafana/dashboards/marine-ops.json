{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "Marine Data Layer — Operations",
  "uid": "marine-ops",
  "tags": ["marine", "ops"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": { "list": [] },
  "panels": [
    {
      "type": "stat",
      "title": "API up",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "up{job=\"marine-api\"}", "legendFormat": "api" } ],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } } }
    },
    {
      "type": "stat",
      "title": "Workers up",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "sum(up{component=\"worker\"})", "legendFormat": "workers" } ]
    },
    {
      "type": "stat",
      "title": "NATS up",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "up{service=\"nats\"}", "legendFormat": "nats" } ]
    },
    {
      "type": "stat",
      "title": "OTel collector up",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "up{service=\"otel-collector\"}", "legendFormat": "otel" } ]
    },
    {
      "type": "timeseries",
      "title": "API request rate (by handler)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "sum by (handler) (rate(http_requests_total{job=\"marine-api\"}[5m]))", "legendFormat": "{{handler}}" } ]
    },
    {
      "type": "timeseries",
      "title": "Ingestion/processing jobs by status (rate)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "sum by (status) (rate(marine_jobs_total[5m]))", "legendFormat": "{{status}}" } ]
    },
    {
      "type": "timeseries",
      "title": "Worker queue depth",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "marine_queue_depth", "legendFormat": "{{queue}}" } ]
    },
    {
      "type": "timeseries",
      "title": "Stale / failed datasets",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "marine_datasets_stale", "legendFormat": "stale" },
        { "expr": "marine_datasets_failed", "legendFormat": "failed" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Active alerts",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "marine_active_alerts", "legendFormat": "{{event_type}}" } ]
    }
  ]
}
