# Base URL for the shared FastAPI REST API. Leave empty to use same-origin
# relative requests (recommended when served behind the same gateway/proxy).
VITE_API_BASE_URL=

# Base URL for the WebSocket alert stream. When empty, the dashboard derives it
# from the current page origin (ws:// or wss://) + /v1/stream/alerts.
VITE_WS_URL=

# Dev-only: where `vite` proxies /v1 REST + WS traffic during `npm run dev`.
VITE_API_TARGET=http://localhost:8000
